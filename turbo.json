{
    "$schema": "https://turborepo.org/schema.json",
    "pipeline": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "test": {
            "dependsOn": ["build"],
            "outputs": ["coverage/**"],
            "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.js", "src/**/*.js", "src/**/*.jsx"]
        },
        "lint": {
            "outputs": []
        },
        "deploy": {
            "dependsOn": ["build", "test", "lint"]
        }
    }
}
