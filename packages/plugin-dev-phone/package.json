{
  "name": "@twilio-labs/plugin-dev-phone",
  "description": "Browser phone for calling and messaging with Twilio",
  "version": "1.0.0-beta.6",
  "author": "Twilio @twilio",
  "bugs": {
    "url": "https://github.com/twilio-labs/dev-phone/issues"
  },
  "dependencies": {
    "@inquirer/confirm": "^5.1.8",
    "@oclif/core": "^1.13.6",
    "@twilio-labs/dev-phone-ui": "^1.0.0-beta.3",
    "@twilio-labs/serverless-api": "^5.4.0",
    "@twilio/cli-core": "8.3.3",
    "express": "^4.17.1",
    "get-port": "^5.1.1",
    "open": "^8.4.0",
    "twilio": "5.13.1"
  },
  "devDependencies": {
    "@twilio/cli-test": "3.0.0",
    "@types/express": "^4.17.13",
    "@types/open": "^6.2.1",
    "chai": "^4.2.0",
    "globby": "^11.0.0",
    "mocha": "11.7.5",
    "nyc": "18.0.0",
    "typescript": "^4.6.2"
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "files": [
    "/oclif.manifest.json",
    "/dist"
  ],
  "homepage": "https://github.com/twilio-labs/dev-phone/packages/dev-phone",
  "keywords": [
    "oclif-plugin"
  ],
  "license": "MIT",
  "oclif": {
    "name": "dev-phone",
    "commands": "./dist/commands",
    "bin": "twilio",
    "repositoryPrefix": "<%- repo %>/blob/<%- version %>/<%- commandPath %>",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "dev-phone": {
        "description": "Twilio Dev Phone plugin"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twilio-labs/dev-phone.git"
  },
  "scripts": {
    "build": "tsc",
    "postpack": "rm -f oclif.manifest.json",
    "standalone": "node dist/standalone.js",
    "XX-posttest": "eslint --ignore-path .gitignore . && npm audit",
    "prepack": "npx oclif manifest && npx oclif readme",
    "test": "nyc --reporter=html --reporter=text mocha --forbid-only \"test/**/*.test.js\"",
    "version": "npx oclif readme && git add README.md"
  },
  "bin": {
    "dev-phone": "dist/standalone.js"
  },
  "directories": {
    "test": "test"
  }
}
